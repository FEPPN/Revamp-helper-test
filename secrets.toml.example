# Copy this into Streamlit Cloud's "Secrets" settings (or a local
# .streamlit/secrets.toml for testing on your own machine) and fill in your
# own real values. NEVER commit a real secrets.toml to the repo.

SERPAPI_API_KEY = "your_serpapi_key_here"

# Google OAuth app (Google Cloud Console > APIs & Services > Credentials).
# These three together are used for BOTH reading Search Console data AND
# creating/sharing the output Google Sheet — one OAuth app, scopes for both
# webmasters.readonly + spreadsheets + drive.file must be enabled under
# "Data access" in Google Auth Platform, or the granted token silently won't
# have them even if you request them in the auth URL.
GSC_CLIENT_ID = "your-client-id.apps.googleusercontent.com"
GSC_CLIENT_SECRET = "your_oauth_client_secret"
GSC_REFRESH_TOKEN = "your_refresh_token_from_the_one_time_oauth_flow"

# Optional — enables the Entités tab (entity-gap vs competitors). Without
# it, the report is still generated, just without that tab.
GOOGLE_NLP_API_KEY = "your_google_nlp_api_key"
