# Copy this file to .env and fill in YOUR OWN values.
# NEVER commit the real .env file — it is gitignored, keep it that way.

# --- SerpAPI (https://serpapi.com) ---
# Personal/team account, used for live Google SERP data (organic results,
# People Also Ask, related searches, AI Overview). Free tier: 250
# searches/month. Get a key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# --- Google Search Console OAuth (see SETUP.md) ---
# Paths are relative to scripts/fetch_gsc.py by default if left unset.
GSC_CLIENT_SECRET_PATH=./secrets/gsc_client_secret.json
GSC_TOKEN_PATH=./secrets/gsc_token.json

# --- Ahrefs ---
# Not an API key here: Ahrefs is accessed via the Ahrefs MCP connector,
# configured at the Claude Code level (ask your team for access). No .env
# entry needed for it.
